{
  "name": "resume-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,pdf \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "tsx scripts/verify-production.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts --production"
  },
  "dependencies": {
    "express": "^5.3.0",
    "idb": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "fake-indexeddb": "^6.2.5",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
