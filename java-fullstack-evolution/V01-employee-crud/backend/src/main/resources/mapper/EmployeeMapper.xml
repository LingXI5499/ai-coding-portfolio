<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC '-//mybatis.org//DTD Mapper 3.0//EN'
  'https://mybatis.org/dtd/mybatis-3-mapper.dtd'>
<mapper namespace="com.lingxi.evolution.mapper.EmployeeMapper">
    <sql id="columns">id, name, gender, age, phone, department, salary, create_time, update_time</sql>
    <sql id="queryConditions">
        <where>
            <if test="query.name != null">
                AND name LIKE #{query.namePattern} ESCAPE '!'
            </if>
            <if test="query.department != null">
                AND department LIKE #{query.departmentPattern} ESCAPE '!'
            </if>
            <if test="query.gender != null">
                AND gender = #{query.gender}
            </if>
            <if test="query.minAge != null">
                AND age &gt;= #{query.minAge}
            </if>
            <if test="query.maxAge != null">
                AND age &lt;= #{query.maxAge}
            </if>
        </where>
    </sql>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM employee
        <include refid="queryConditions"/>
    </select>
    <select id="search" resultType="com.lingxi.evolution.entity.Employee">
        SELECT <include refid="columns"/> FROM employee
        <include refid="queryConditions"/>
        ORDER BY id ASC
        LIMIT #{query.pageSize} OFFSET #{query.offset}
    </select>
    <select id="findById" resultType="com.lingxi.evolution.entity.Employee">
        SELECT
        <include refid="columns"/>
         FROM employee WHERE id = #{id}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO employee(name, gender, age, phone, department, salary) VALUES(#{name}, #{gender}, #{age}, #{phone}, #{department}, #{salary})</insert>
    <update id="update">UPDATE employee SET name=#{name}, gender=#{gender}, age=#{age}, phone=#{phone}, department=#{department}, salary=#{salary}, update_time=CURRENT_TIMESTAMP WHERE id=#{id}</update>
    <delete id="delete">DELETE FROM employee WHERE id=#{id}</delete>
</mapper>
