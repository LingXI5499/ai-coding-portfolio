SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
PORT=8090
DB_URL=jdbc:mysql://127.0.0.1:3306/java_fullstack_v10?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
COOKIE_SECURE=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# 文件上传默认本地私有存储；选择 oss 时填写该组配置，不提交真实值。
FILES_STORAGE=local
# systemd 生产目录；本地开发不配置时默认 .local-uploads。
FILES_LOCAL_ROOT=/var/lib/evolution/uploads
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
