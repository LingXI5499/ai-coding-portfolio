# Web
APP_NAME=AI 情报日报
HOST=127.0.0.1
PORT=8000
TIMEZONE=Asia/Shanghai
ENABLE_SCHEDULER=true

# Database
DATABASE_PATH=data/app.db

# Collection
COLLECTOR_TIMEOUT=15
NEWS_LIMIT_PER_SOURCE=12
JOBS_LIMIT=20

# DeepSeek (留空时系统仍可运行，只显示本地规则摘要)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=45

# Data source URLs (正常无需修改)
BAIDU_URL=https://top.baidu.com/board?tab=realtime
HACKERNEWS_API=https://hacker-news.firebaseio.com/v0
GITHUB_TRENDING_URL=https://github.com/trending?since=daily
POLICY_URL=https://www.gov.cn/zhengce/zuixin/
JOBS_URL=https://raw.githubusercontent.com/jiabaobei/xiaozhao-radar/main/jobs.json
